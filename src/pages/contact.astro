---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { DESTINATIONS } from '../data/destinations';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const interests = ['Medinas & history', 'Food & cooking', 'Sahara nights', 'Mountain walks', 'Coast & surf', 'Crafts & shopping', 'Festivals & music', 'Hammam & rest'];
const input = 'mt-1 w-full border-0 border-b border-dashed border-ink/50 bg-transparent px-0 py-2.5 font-serif text-lg font-light outline-none transition focus:border-solid focus:border-ink aria-[invalid=true]:border-solid aria-[invalid=true]:border-[#9a3b2a]';
const label = 'font-sans text-[0.72rem] uppercase tracking-[0.15em] text-gold';
---
<Base
  title="Plan Your Morocco Trip: Contact & Booking"
  description="Tell Azul Morocco your dates, pace and interests and get a tailor-made, day-by-day Morocco itinerary: Marrakech, Fes, the Sahara, the Atlas and the coast."
>
  <section class="container-x grid gap-14 pb-24 pt-32 md:grid-cols-12 md:pt-40">
    <div class="md:col-span-5">
      <div class="md:sticky md:top-28">
        <p class="eyebrow">Contact & booking</p>
        <h1 class="display-left mt-5 text-[4rem] md:text-[6rem]">Let’s sketch<br />your Morocco</h1>
        <p class="body-copy mt-6 text-ink/85">
          Tell us a little about your trip. Within two working days you will receive a first day-by-day route with places to stay, drive times and honest notes. No payment and no obligation.
        </p>
        <div class="mt-10 hidden md:block">
          <Photo slot="jemaa" ratio="4/5" sizes="40vw" label="Jemaa el-Fnaa" />
        </div>
      </div>
    </div>

    <div class="md:col-span-7">
      <form id="trip-form" class="bg-linen p-6 sm:p-12" novalidate data-endpoint={endpoint} data-places={JSON.stringify(DESTINATIONS.map((d) => d.name))}>
        <fieldset class="grid gap-6 sm:grid-cols-2">
          <legend class="eyebrow mb-6">About you</legend>
          <div>
            <label class={label} for="name">Your name</label>
            <input class={input} id="name" name="name" autocomplete="name" required />
            <p class="field-error mt-1 hidden text-sm text-[#9a3b2a]">Please tell us your name.</p>
          </div>
          <div>
            <label class={label} for="email">Email</label>
            <input class={input} id="email" name="email" type="email" autocomplete="email" required />
            <p class="field-error mt-1 hidden text-sm text-[#9a3b2a]">Please enter a valid email address.</p>
          </div>
          <div class="sm:col-span-2">
            <label class={label} for="country">Travelling from <span class="font-normal text-ink/75">(optional)</span></label>
            <input class={input} id="country" name="country" autocomplete="country-name" />
          </div>
        </fieldset>

        <fieldset class="mt-12 grid gap-6 sm:grid-cols-3">
          <legend class="eyebrow mb-6">Your trip</legend>
          <div>
            <label class={label} for="arrival">Arrival date</label>
            <input class={input} id="arrival" name="arrival" type="date" required />
            <p class="field-error mt-1 hidden text-sm text-[#9a3b2a]">Please choose a future date.</p>
          </div>
          <div>
            <label class={label} for="nights">Nights</label>
            <input class={input} id="nights" name="nights" type="number" min="2" max="60" value="8" required />
            <p class="field-error mt-1 hidden text-sm text-[#9a3b2a]">Between 2 and 60 nights.</p>
          </div>
          <div>
            <label class={label} for="travellers">Travellers</label>
            <input class={input} id="travellers" name="travellers" type="number" min="1" max="20" value="2" required />
            <p class="field-error mt-1 hidden text-sm text-[#9a3b2a]">Between 1 and 20 people.</p>
          </div>
          <div class="sm:col-span-3">
            <label class={label} for="budget">Budget per person, excluding flights</label>
            <select class={input} id="budget" name="budget">
              <option>Not sure yet</option>
              <option>Under €1,000</option>
              <option>€1,000 – €2,000</option>
              <option>€2,000 – €3,500</option>
              <option>Over €3,500</option>
            </select>
          </div>
        </fieldset>

        <fieldset class="mt-12">
          <legend class="eyebrow mb-5">What are you dreaming of?</legend>
          <div class="flex flex-wrap gap-2">
            {interests.map((i) => (
              <label class="cursor-pointer">
                <input type="checkbox" name="interests" value={i} class="peer sr-only" />
                <span class="inline-block border border-dashed border-ink/50 px-4 py-2 font-sans text-[0.72rem] uppercase tracking-[0.12em] text-ink/80 transition peer-checked:border-solid peer-checked:border-night peer-checked:bg-night peer-checked:text-white peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-gold">{i}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="mt-12">
          <legend class="eyebrow mb-5">Your pace</legend>
          <div class="grid gap-3 sm:grid-cols-3">
            {[['slow', 'Slow', 'Few places, long stays'], ['balanced', 'Balanced', 'A bit of everything'], ['full', 'Full', 'See as much as possible']].map(([v, t, d], idx) => (
              <label class="cursor-pointer">
                <input type="radio" name="pace" value={v} class="peer sr-only" checked={idx === 0} />
                <span class="block border border-dashed border-ink/50 p-4 transition peer-checked:border-solid peer-checked:border-night peer-checked:bg-white peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-gold">
                  <span class="block font-serif text-xl">{t}</span>
                  <span class="block font-sans text-xs text-ink/80">{d}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="mt-12">
          <label class={label} for="message">Anything else? <span class="font-normal text-ink/75">(optional)</span></label>
          <textarea class={`${input} min-h-36`} id="message" name="message" rows="5" placeholder="A special occasion, mobility needs, a place you’ve always wanted to see…"></textarea>
        </div>

        <label class="mt-8 flex items-start gap-3 text-sm">
          <input type="checkbox" name="consent" id="consent" required class="mt-1 h-4 w-4 accent-[#231f20]" />
          <span class="body-copy text-[1rem]">I agree that Azul Morocco may use these details to reply to my request.</span>
        </label>
        <p class="field-error consent-error mt-1 hidden text-sm text-[#9a3b2a]">Please tick this box so we can reply.</p>

        <button type="submit" class="btn-dash mt-10 w-full py-3.5 text-night sm:w-auto">Send my trip request</button>
        <p id="form-status" class="mt-5 text-sm" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('trip-form') as HTMLFormElement;
  const status = document.getElementById('form-status')!;
  const arrival = form.querySelector<HTMLInputElement>('#arrival')!;

  // "Plan a trip to Fes" links pass ?place=Fes; only known destinations are accepted.
  const place = new URLSearchParams(location.search).get('place');
  const places: string[] = JSON.parse(form.dataset.places ?? '[]');
  const message = form.querySelector<HTMLTextAreaElement>('#message')!;
  if (place && places.includes(place) && !message.value) message.value = `I’d love my trip to include ${place}.`;
  arrival.min = new Date().toISOString().slice(0, 10);

  const fields = Array.from(form.querySelectorAll<HTMLInputElement>('input[required]:not([type=checkbox])'));
  const consent = form.querySelector<HTMLInputElement>('#consent')!;

  const check = (el: HTMLInputElement) => {
    const ok = el.checkValidity() && el.value.trim() !== '';
    el.setAttribute('aria-invalid', String(!ok));
    el.parentElement?.querySelector('.field-error')?.classList.toggle('hidden', ok);
    return ok;
  };
  fields.forEach((el) => el.addEventListener('blur', () => check(el)));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const valid = fields.map(check).every(Boolean);
    form.querySelector('.consent-error')!.classList.toggle('hidden', consent.checked);
    if (!valid || !consent.checked) {
      status.textContent = 'Please check the highlighted fields.';
      status.className = 'mt-5 font-sans text-sm text-[#9a3b2a]';
      (form.querySelector('[aria-invalid=true]') as HTMLElement | null ?? consent).focus();
      return;
    }

    const data = new FormData(form);
    const payload = { ...Object.fromEntries(data), interests: data.getAll('interests') };
    const endpoint = form.dataset.endpoint;

    if (!endpoint) {
      // No backend connected yet: be honest rather than pretend it was sent.
      status.textContent = 'Thank you! Online requests are not switched on yet, so nothing has been sent. Please check back soon.';
      status.className = 'mt-5 bg-greige p-4 font-sans text-sm text-ink';
      return;
    }

    status.textContent = 'Sending…';
    status.className = 'mt-5 font-sans text-sm text-ink/70';
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.textContent = 'Shukran! Your request is on its way. Expect a first route within two working days.';
      status.className = 'mt-5 bg-greige p-4 font-sans text-sm text-ink';
    } catch {
      status.textContent = 'Something went wrong while sending. Please try again in a moment.';
      status.className = 'mt-5 bg-greige p-4 font-sans text-sm text-[#9a3b2a]';
    }
  });
</script>
