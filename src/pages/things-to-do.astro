---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import SectionHead from '../components/SectionHead.astro';
import { EXPERIENCES, FESTIVALS, FOODS } from '../data/experiences';

const more = [
  { title: 'Visit the Hassan II Mosque', where: 'Casablanca', text: 'One of the few mosques in Morocco that non-Muslims can enter, on a guided tour. Its minaret rises above the Atlantic.' },
  { title: 'Walk among Roman ruins', where: 'Volubilis, near Meknes', text: 'Mosaics still in place on the floors of a Roman town at the edge of the empire.' },
  { title: 'Taste saffron at the source', where: 'Taliouine', text: 'Visit a cooperative in the saffron capital during the autumn harvest, when the purple crocus fields bloom.' },
  { title: 'Hike to Ouzoud falls', where: 'Azilal province', text: 'Cascades over 100 metres high, olive groves and Barbary macaques on the trail.' },
  { title: 'Watch the sunset in the Agafay', where: 'Near Marrakech', text: 'A stony desert under an hour from the city: camel rides, quad bikes or just a long dinner under the stars.' },
  { title: 'Learn some Darija', where: 'Anywhere', text: 'A few words of Moroccan Arabic or Tamazight open doors faster than any guidebook.' },
];
const small = 'font-sans text-[0.72rem] uppercase tracking-[0.15em]';
---
<Base
  title="Things to Do in Morocco: Desert Camps, Atlas Hikes, Hammams & Festivals"
  description="The best things to do in Morocco: a night in the Merzouga dunes, High Atlas treks, cooking classes, hammams, surfing in Taghazout, the Fes tanneries and the festival calendar."
  overlayHeader
>
  <PageHero
    slot="souk"
    eyebrow="Things to do"
    title="Say yes to the<br />second glass"
    intro="Desert nights, mountain paths, hammam steam and a festival calendar that follows the seasons. These are the experiences we build trips around."
    label="Spice souk"
  />

  <section class="bg-char py-24 text-white md:py-32">
    <div class="container-x">
      <SectionHead tone="light" eyebrow="Signature experiences" title="What we would do<br />again tomorrow" />
      <div class="mt-16 grid gap-x-6 gap-y-16 sm:grid-cols-2 lg:grid-cols-4">
        {EXPERIENCES.map((e) => (
          <article id={`exp-${e.slot}`} class="reveal scroll-mt-28">
            <Photo slot={e.slot} ratio="3/2" sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" label={e.title} />
            <p class:list={[small, 'mt-5 text-white/70']}>{e.tag} · {e.where}</p>
            <h3 class="mt-2 font-serif text-[1.6rem] leading-tight">{e.title}</h3>
            <p class="body-copy mt-3 text-[1rem] text-white/85">{e.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="grid md:grid-cols-2">
    <Photo slot="gnaoua" ratio="1/1" sizes="(min-width: 768px) 50vw, 100vw" fluid class="aspect-[1/1] min-w-0 h-full md:aspect-auto" label="Gnawa musicians" />
    <div class="px-6 py-20 sm:px-12 lg:px-20">
      <p class="eyebrow">Festivals & moussems</p>
      <h2 class="display-left mt-5 text-[3.4rem] md:text-[4.4rem]">Time your trip<br />to the music</h2>
      <p class="body-copy mt-4 max-w-md text-ink/80">Dates move every year, and some follow the lunar calendar. Check official dates before booking.</p>
      <ol class="mt-10">
        {FESTIVALS.map((f, i) => (
          <li class="reveal grid grid-cols-[2.5rem_1fr] gap-4 border-b border-dashed border-ink/40 py-5 first:border-t first:border-solid first:border-t-ink">
            <span class="pt-1 font-sans text-[0.72rem] text-ink/75">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <p class:list={[small, 'text-gold']}>{f.when} · {f.where}</p>
              <h3 class="mt-1 font-serif text-[1.5rem] leading-tight">{f.name}</h3>
              <p class="body-copy mt-1 text-[1rem] text-ink/75">{f.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="grid md:grid-cols-[1fr_1.86fr]">
    <div class="reveal flex flex-col items-center justify-center bg-greige px-8 py-20 text-center md:order-1">
      <p class="eyebrow">Shopping the souks</p>
      <h2 class="display mt-5 text-[3.4rem] md:text-[4.4rem]">Haggle<br />with a smile</h2>
      <div class="body-copy mt-6 max-w-[300px] space-y-4 text-[1rem] text-ink/85">
        <p>Bargaining is a conversation, not a battle. Ask the price, offer what feels fair, meet in the middle over tea. Not interested? A friendly <em>la, shukran</em> is enough.</p>
        <p>Look for cedar boxes in Fes, Amazigh rugs woven in the Middle and High Atlas, argan oil from women’s cooperatives and thuya-wood marquetry in Essaouira.</p>
      </div>
    </div>
    <div class="md:order-2">
      <Photo slot="zellige" ratio="1/1" sizes="(min-width: 768px) 65vw, 100vw" fluid class="aspect-[1/1] min-w-0 h-full md:aspect-auto md:min-h-[640px]" label="Zellige tilework" />
    </div>
  </section>

  <section class="bg-linen py-24 md:py-32">
    <div class="container-x">
      <SectionHead eyebrow="Food to try" title="Best understood<br />at the table" />
      <div class="mt-16 grid gap-12 md:grid-cols-[1fr_1.4fr]">
        <Photo slot="tagine" ratio="4/5" sizes="(min-width: 768px) 40vw, 100vw" label="Tagine" />
        <ul class="grid content-start gap-x-10 sm:grid-cols-2">
          {FOODS.map((f) => (
            <li class="reveal border-t border-dashed border-ink/40 py-5">
              <h3 class="font-serif text-[1.5rem]">{f.name}</h3>
              <p class="body-copy mt-1 text-[1rem] text-ink/75">{f.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="container-x py-24 md:py-32">
    <SectionHead eyebrow="If you have more time" title="Six more<br />good ideas" />
    <ul class="mt-16 grid gap-px bg-ink/15 sm:grid-cols-2 lg:grid-cols-3">
      {more.map((m) => (
        <li class="reveal bg-white p-8 text-center">
          <p class:list={[small, 'text-gold']}>{m.where}</p>
          <h3 class="mt-3 font-serif text-[1.6rem] leading-tight">{m.title}</h3>
          <p class="body-copy mt-3 text-[1rem] text-ink/75">{m.text}</p>
        </li>
      ))}
    </ul>
    <div class="mt-16 text-center"><a href="/contact/" class="btn-dash text-mute">Build these into my trip</a></div>
  </section>
</Base>
