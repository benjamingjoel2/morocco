---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import SectionHead from '../components/SectionHead.astro';
import { EXPERIENCES, FESTIVALS, FOODS } from '../data/experiences';

const more = [
  { title: 'Visit the Hassan II Mosque', where: 'Casablanca', text: 'One of the few mosques in Morocco that non-Muslims can enter, on a guided tour. Its minaret rises above the Atlantic.' },
  { title: 'Walk among Roman ruins', where: 'Volubilis, near Meknes', text: 'Mosaics still in place on the floors of a Roman town at the edge of the empire.' },
  { title: 'Taste saffron at the source', where: 'Taliouine', text: 'Visit a cooperative in the saffron capital during the autumn harvest, when the purple crocus fields bloom.' },
  { title: 'Hike to Ouzoud falls', where: 'Azilal province', text: 'Cascades over 100 metres high, olive groves and Barbary macaques on the trail.' },
  { title: 'Watch the sunset in the Agafay', where: 'Near Marrakech', text: 'A stony desert under an hour from the city: camel rides, quad bikes or just a long dinner under the stars.' },
  { title: 'Learn some Darija', where: 'Anywhere', text: 'A few words of Moroccan Arabic or Tamazight open doors faster than any guidebook.' },
];
---
<Base
  title="Things to Do in Morocco: Desert Camps, Atlas Hikes, Hammams & Festivals"
  description="The best things to do in Morocco: a night in the Merzouga dunes, High Atlas treks, cooking classes, hammams, surfing in Taghazout, the Fes tanneries and the festival calendar."
  overlayHeader
>
  <PageHero
    slot="souk"
    eyebrow="Things to do"
    title="Say yes to the <em>second</em> glass of tea"
    intro="Desert nights, mountain paths, hammam steam and a festival calendar that follows the seasons. These are the experiences we build trips around."
    label="Spice souk"
  />

  <section class="container-x py-24 md:py-32">
    <SectionHead eyebrow="Signature experiences" title="What we’d do <em>again</em> tomorrow" />
    <div class="mt-16 grid gap-x-8 gap-y-16 sm:grid-cols-2 lg:grid-cols-4">
      {EXPERIENCES.map((e, i) => (
        <article class:list={['reveal', i % 4 === 1 && 'lg:mt-14', i % 4 === 3 && 'lg:mt-14']}>
          <Photo slot={e.slot} ratio="4/5" sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" class:list={[i % 2 === 0 ? 'arch-mask' : 'rounded-[1.25rem]']} label={e.title} />
          <p class="eyebrow mt-5">{e.tag} · {e.where}</p>
          <h2 class="mt-2 text-3xl leading-tight">{e.title}</h2>
          <p class="mt-3 text-ink/75">{e.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Festivals -->
  <section class="zellige-bg relative bg-ink text-sand">
    <div class="absolute inset-0 bg-ink/[0.93]"></div>
    <div class="container-x relative grid gap-14 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5">
        <SectionHead tone="light" eyebrow="Festivals & moussems" title="Time your trip to the <em>music</em>" intro="Dates move every year, and some follow the lunar calendar. Check the official dates before booking." />
        <div class="reveal mt-10">
          <Photo slot="gnaoua" ratio="4/3" sizes="(min-width: 768px) 40vw, 100vw" class="rounded-[1.25rem]" label="Gnawa musicians" />
        </div>
      </div>
      <ol class="md:col-span-7">
        {FESTIVALS.map((f) => (
          <li class="reveal border-t border-sand/20 py-7 last:border-b">
            <p class="eyebrow !text-saffron">{f.when} · {f.where}</p>
            <h3 class="mt-2 text-3xl">{f.name}</h3>
            <p class="mt-2 text-sand/75">{f.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Souks -->
  <section class="container-x grid items-center gap-14 py-24 md:grid-cols-12 md:py-32">
    <div class="reveal md:col-span-6 md:order-2">
      <Photo slot="zellige" ratio="1/1" sizes="(min-width: 768px) 50vw, 100vw" class="rounded-full" label="Zellige tilework" />
    </div>
    <div class="md:col-span-6">
      <SectionHead eyebrow="Shopping the souks" title="Haggle with a <em>smile</em>" />
      <div class="reveal prose-azul mt-6">
        <p>Bargaining is a conversation, not a battle. Ask the price, offer what feels fair to you, and meet somewhere in the middle over tea. If you’re not interested, a friendly <em>la, shukran</em> (no, thank you) is enough.</p>
        <p>Look for cedar boxes and carved plaster in Fes, Amazigh rugs woven in the Middle and High Atlas, argan oil from women’s cooperatives near Essaouira, and thuya-wood marquetry in Essaouira’s workshops.</p>
        <p>Fixed-price shops (<em>ensembles artisanaux</em>) in most cities are a calm way to learn what quality and prices look like before you dive into the souk.</p>
      </div>
    </div>
  </section>

  <!-- Food -->
  <section class="bg-plaster py-24 md:py-32">
    <div class="container-x">
      <SectionHead eyebrow="Food to try" title="A country best understood <em>at the table</em>" />
      <div class="mt-14 grid gap-10 md:grid-cols-12">
        <div class="reveal md:col-span-5">
          <Photo slot="tagine" ratio="4/5" sizes="(min-width: 768px) 40vw, 100vw" class="arch-mask" label="Tagine" />
        </div>
        <ul class="reveal grid content-start gap-x-10 gap-y-8 sm:grid-cols-2 md:col-span-7">
          {FOODS.map((f) => (
            <li class="border-t border-ink/15 pt-5">
              <h3 class="text-2xl">{f.name}</h3>
              <p class="mt-2 text-ink/75">{f.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- More -->
  <section class="container-x py-24 md:py-32">
    <SectionHead eyebrow="If you have more time" title="Six more <em>good ideas</em>" />
    <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {more.map((m) => (
        <li class="reveal rounded-2xl bg-plaster p-7">
          <p class="eyebrow !text-mint">{m.where}</p>
          <h3 class="mt-3 text-2xl">{m.title}</h3>
          <p class="mt-3 text-ink/75">{m.text}</p>
        </li>
      ))}
    </ul>
    <div class="mt-14">
      <a href="/contact/" class="btn-clay">Build these into my trip</a>
    </div>
  </section>
</Base>
