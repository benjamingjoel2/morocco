---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import { DESTINATIONS, type Destination } from '../../data/destinations';
import { DETAILS } from '../../data/destinationDetails';
import { getPhoto, unsplashUrl } from '../../data/media';

export function getStaticPaths() {
  return DESTINATIONS.map((d) => ({ params: { id: d.id }, props: { d } }));
}

const { d } = Astro.props as { d: Destination };
const x = DETAILS[d.id];
const nearby = x.nearby.map((id) => DESTINATIONS.find((n) => n.id === id)!).filter(Boolean);
const short = d.name.split(',')[0].split(' & ')[0];
const label = 'font-sans text-[0.72rem] uppercase tracking-[0.15em] text-gold';
const site = Astro.site!;
const gallery = [`${d.id}-g1`, `${d.id}-g2`].map((slot) => ({ slot, p: getPhoto(slot) })).filter((g) => g.p);
const main = getPhoto(d.slot);
// Share previews show this destination's own photo, cropped to 1200x630
const ogImage = main ? unsplashUrl(main.src, 1200, '40/21', 80) : undefined;

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristDestination',
    name: d.name,
    description: d.intro,
    url: new URL(`/destinations/${d.id}/`, site).toString(),
    containedInPlace: { '@type': 'Country', name: 'Morocco' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Destinations', item: new URL('/destinations/', site).toString() },
      { '@type': 'ListItem', position: 3, name: d.name },
    ],
  },
];
---
<Base
  title={`${d.name} travel guide: what to do, where to stay, when to go`}
  description={`${d.tagline}. Our ${d.name} guide: a perfect day, where to stay, the best time to visit, how to get there and what not to miss.`}
  overlayHeader
  ogImage={ogImage}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <PageHero slot={d.slot} eyebrow={d.region} title={d.name.replace(' & ', '<br />& ').replace(', ', ',<br />')} intro={d.tagline} label={d.name} />

  <nav aria-label="Breadcrumb" class="container-x py-5">
    <ol class="flex flex-wrap gap-2 font-sans text-[0.72rem] uppercase tracking-[0.15em] text-ink/75">
      <li><a href="/" class="hover:text-ink">Home</a> /</li>
      <li><a href="/destinations/" class="hover:text-ink">Destinations</a> /</li>
      <li aria-current="page" class="text-ink">{d.name}</li>
    </ol>
  </nav>

  <section class="grid md:grid-cols-2">
    <div class="reveal flex flex-col justify-center bg-greige px-6 py-20 sm:px-12 lg:px-20">
      <p class="eyebrow">Why go</p>
      <p class="body-copy mt-5 text-[1.3rem] text-ink">{d.intro}</p>
      <dl class="mt-10 grid gap-5 border-y border-dashed border-ink/40 py-6 sm:grid-cols-2">
        <div><dt class={label}>Stay</dt><dd class="mt-1 font-serif text-lg">{d.stay}</dd></div>
        <div><dt class={label}>Best time</dt><dd class="mt-1 font-serif text-lg">{d.season}</dd></div>
        <div class="sm:col-span-2"><dt class={label}>Getting there</dt><dd class="mt-1 font-serif text-lg font-light">{d.gettingThere}</dd></div>
      </dl>
      <p class="mt-6 font-sans text-[0.72rem] uppercase tracking-[0.15em] text-ink/75">Best for · {d.bestFor.join(' · ')}</p>
    </div>
    <Photo slot={d.slot} ratio="4/5" fluid sizes="(min-width: 768px) 50vw, 100vw" class="aspect-[4/5] min-w-0 h-full md:aspect-auto md:min-h-[640px]" label={d.name} />
  </section>

  <section class="container-x py-24 md:py-32">
    <div class="reveal mx-auto max-w-[620px] text-center">
      <p class="eyebrow">A perfect day in {short}</p>
      <h2 class="display mt-6 text-[3.4rem] md:text-[4.4rem]">From first light<br />to last tea</h2>
    </div>
    <ol class="mt-16 grid gap-10 md:grid-cols-3 md:gap-8">
      {([['01', 'Morning', x.day.morning], ['02', 'Afternoon', x.day.afternoon], ['03', 'Evening', x.day.evening]] as const).map(([n, t, text]) => (
        <li class="reveal text-center">
          <span class="font-sans text-[0.72rem] text-ink/75">{n}</span>
          <h3 class="display mt-1 text-[2.6rem]">{t}</h3>
          <div class="rule-dots mt-5 text-ink/50"></div>
          <p class="body-copy mx-auto mt-5 max-w-sm text-ink/85">{text}</p>
        </li>
      ))}
    </ol>
  </section>

  {gallery.length > 0 && (
    <section class="pb-24 md:pb-32" aria-label={`Photos of ${d.name}`}>
      <div class:list={['grid gap-1', gallery.length > 1 && 'md:grid-cols-2']}>
        {gallery.map(({ slot, p }) => (
          <figure class="reveal">
            <Photo slot={slot} ratio={gallery.length > 1 ? '4/3' : '21/9'} sizes={gallery.length > 1 ? '(min-width: 768px) 50vw, 100vw' : '100vw'} label={d.name} />
            <figcaption class="container-x mt-3 font-sans text-[0.72rem] uppercase tracking-[0.15em] text-ink/75">
              {p!.location} · <a href={p!.photographerUrl} class="hover:underline" rel="noopener">{p!.photographer}</a> / Unsplash
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <section class="bg-linen py-24 md:py-32">
    <div class="container-x grid gap-16 md:grid-cols-2">
      <div class="reveal">
        <p class="eyebrow">Where to stay</p>
        <ul class="mt-6 border-t border-ink">
          {x.stay.map((s) => (
            <li class="border-b border-dashed border-ink/40 py-5">
              <h3 class="font-serif text-[1.5rem]">{s.area}</h3>
              <p class="body-copy mt-1 text-[1rem] text-ink/80">{s.text}</p>
            </li>
          ))}
        </ul>
      </div>
      <div class="reveal">
        <p class="eyebrow">Don’t miss</p>
        <ul class="mt-6 border-t border-ink">
          {d.dontMiss.map((m) => <li class="body-copy border-b border-dashed border-ink/40 py-3 text-[1.05rem]">{m}</li>)}
        </ul>
        <p class="eyebrow mt-12">Good to know</p>
        <ul class="mt-6 border-t border-ink">
          {x.tips.map((t) => <li class="body-copy border-b border-dashed border-ink/40 py-3 text-[1.05rem]">{t}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="container-x py-24 md:py-32">
    <p class="eyebrow text-center">Pairs well with</p>
    <div class="mt-14 grid gap-10 sm:grid-cols-3 sm:gap-4">
      {nearby.map((n) => (
        <a href={`/destinations/${n.id}/`} class="reveal group block">
          <Photo slot={n.slot} ratio="2/3" sizes="(min-width: 640px) 33vw, 100vw" imgClass="transition-transform duration-700 group-hover:scale-[1.03]" label={n.name} />
          <p class="mt-5 font-sans text-[0.72rem] uppercase tracking-[0.15em] text-ink/75">{n.region}</p>
          <h3 class="mt-2 font-serif text-[1.6rem] leading-tight">{n.name}</h3>
          <p class="body-copy mt-1 text-[1rem] text-ink/80">{n.tagline}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-char py-24 text-center text-white md:py-32">
    <div class="reveal container-x">
      <p class="eyebrow !text-gold-soft">Your trip</p>
      <p class="display mt-6 !text-white text-[3.4rem] md:text-[5.5rem]">Make {short}<br />part of your route</p>
      <a href={`/contact/?place=${encodeURIComponent(d.name)}`} class="btn-dash mt-10 text-white">Plan a trip to {short}</a>
    </div>
  </section>
</Base>
