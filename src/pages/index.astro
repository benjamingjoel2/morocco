---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Photo from '../components/Photo.astro';
import SectionHead from '../components/SectionHead.astro';
import { DESTINATIONS } from '../data/destinations';
import { EXPERIENCES, FOODS } from '../data/experiences';

const featured = DESTINATIONS.filter((d) => ['marrakech', 'chefchaouen', 'sahara', 'essaouira'].includes(d.id));

const ways = [
  {
    slot: 'fes',
    eyebrow: 'The medina',
    title: 'Get <em>gloriously</em> lost',
    text: 'Fes and Marrakech reward slow wandering: the scent of cedar shavings in the carpenters’ souk, a fountain of zellige tucked in a dead-end lane, bread carried to the communal oven on a boy’s head. We’ll show you how to enjoy the maze, and how to find your way out.',
    link: { href: '/destinations/#fes', label: 'Discover Fes' },
  },
  {
    slot: 'atlas',
    eyebrow: 'The mountains',
    title: 'Walk with the <em>Atlas</em>',
    text: 'An hour and a half from the souks, mule paths climb between walnut terraces and earth-walled villages. Stay in a family guesthouse in Imlil, hike to a pass for lunch, and fall asleep to nothing but the river.',
    link: { href: '/destinations/#atlas', label: 'Discover the High Atlas' },
  },
  {
    slot: 'sahara',
    eyebrow: 'The desert',
    title: 'Hear the <em>silence</em> of the dunes',
    text: 'The Erg Chebbi rises out of the stony plain like a wave of apricot sand. Arrive before sunset, eat around the fire, and climb a dune in the blue hour before dawn. It is the night most travellers talk about for years.',
    link: { href: '/destinations/#sahara', label: 'Discover the Sahara' },
  },
];

const route = [
  { day: 'Days 1–3', place: 'Marrakech', text: 'Riad, souks, gardens and a food walk through Jemaa el-Fnaa.' },
  { day: 'Day 4', place: 'Tizi n’Tichka → Aït Benhaddou', text: 'Cross the High Atlas and sleep near the ksar.' },
  { day: 'Day 5', place: 'Dadès & Todra gorges', text: 'Canyon walks and the Road of a Thousand Kasbahs.' },
  { day: 'Day 6', place: 'Merzouga', text: 'Sunset ride into the Erg Chebbi and a night in camp.' },
  { day: 'Days 7–8', place: 'Fes', text: 'Ziz valley drive north, then two days in the old medina.' },
];

const steps = [
  { n: '01', title: 'Tell us', text: 'Share your dates, pace and wish list in our short trip form. No commitment, no payment.' },
  { n: '02', title: 'We sketch a route', text: 'Within two working days you get a day-by-day draft with stays, drives and honest notes.' },
  { n: '03', title: 'You travel', text: 'Fine-tune it together, then go. A local contact is a message away the whole trip.' },
];
---
<Base
  title="Azul Morocco · Slow, tailor-made journeys through Morocco"
  description="Azul Morocco is an independent guide to Morocco: Marrakech, Fes, Chefchaouen, the Sahara at Merzouga, the Atlas Mountains and Essaouira, with tailor-made trip planning."
  overlayHeader
>
  <Hero />

  <!-- Welcome -->
  <section class="container-x grid items-center gap-12 py-24 md:grid-cols-12 md:py-36">
    <div class="reveal md:col-span-7">
      <p class="eyebrow">Azul · ⴰⵣⵓⵍ · Hello</p>
      <h2 class="mt-5 text-balance text-4xl leading-[1.05] md:text-6xl">
        In Tamazight, <em class="text-clay">azul</em> is how you say hello. It is also how we would like your trip to begin: warmly, and without a rush.
      </h2>
      <p class="mt-8 max-w-xl text-lg text-ink/75">
        Morocco rewards travellers who slow down. Instead of ten cities in ten days, we help you choose a few places and really arrive: the same café two mornings in a row, a guide who knows your name, time to say yes to a second glass of tea.
      </p>
      <a href="/travel-tips/" class="mt-8 inline-flex items-center gap-2 font-semibold text-clay underline-offset-8 hover:underline">Read our honest travel tips →</a>
    </div>
    <div class="reveal md:col-span-5">
      <Photo slot="madrasa" ratio="4/5" sizes="(min-width: 768px) 40vw, 100vw" class="arch-mask rounded-b-[2rem]" label="Ben Youssef Madrasa" />
    </div>
  </section>

  <!-- Three ways (checkerboard) -->
  <section class="bg-plaster">
    <div class="container-x pt-24 md:pt-32">
      <SectionHead eyebrow="Three ways to feel Morocco" title="Medina, mountain, <em>desert</em>" />
    </div>
    <div class="mt-16">
      {ways.map((w, i) => (
        <div class="grid md:grid-cols-12">
          <div class:list={['md:col-span-7', i % 2 === 1 && 'md:order-2']}>
            <Photo slot={w.slot} ratio="4/3" sizes="(min-width: 768px) 58vw, 100vw" class="h-full" label={w.eyebrow} />
          </div>
          <div class:list={['reveal flex items-center px-6 py-14 sm:px-10 md:col-span-5 md:px-14 lg:px-20', i === 1 ? 'bg-chaouen/40' : 'bg-sand']}>
            <div>
              <p class="eyebrow">{w.eyebrow}</p>
              <h3 class="mt-4 text-4xl leading-tight md:text-5xl" set:html={w.title} />
              <p class="mt-5 text-ink/75">{w.text}</p>
              <a href={w.link.href} class="mt-6 inline-flex font-semibold text-clay underline-offset-8 hover:underline">{w.link.label} →</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Destinations -->
  <section class="container-x py-24 md:py-36">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <SectionHead eyebrow="Where to go" title="Places that <em>stay</em> with you" intro="Eight regions, each with its own light, food and rhythm. Start with these four." />
      <a href="/destinations/" class="btn-ghost shrink-0 self-start text-clay md:self-end">All destinations</a>
    </div>
    <div class="rail -mx-5 mt-14 flex gap-5 overflow-x-auto px-5 pb-4 md:mx-0 md:grid md:grid-cols-4 md:gap-6 md:overflow-visible md:px-0">
      {featured.map((d, i) => (
        <a href={`/destinations/#${d.id}`} class:list={['reveal group block w-[78%] shrink-0 sm:w-[45%] md:w-auto', i % 2 === 1 && 'md:mt-16']}>
          <Photo slot={d.slot} ratio="3/4" sizes="(min-width: 768px) 25vw, 80vw" class="rounded-t-full" imgClass="transition-transform duration-700 group-hover:scale-[1.04]" label={d.name} />
          <p class="eyebrow mt-5">{d.region}</p>
          <h3 class="mt-2 text-3xl">{d.name}</h3>
          <p class="mt-2 text-ink/70">{d.tagline}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Things to do rail -->
  <section class="zellige-bg relative overflow-hidden bg-ink py-24 text-sand md:py-32">
    <div class="absolute inset-0 bg-ink/[0.93]"></div>
    <div class="container-x relative">
      <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
        <SectionHead tone="light" eyebrow="Things to do" title="Days you’ll <em>remember</em>" intro="Drag or scroll the row. Every one of these can be woven into a tailor-made trip." />
        <div class="flex gap-3" aria-hidden="true">
          <button class="rail-prev h-12 w-12 rounded-full border border-sand/40 hover:bg-sand hover:text-ink" tabindex="-1">←</button>
          <button class="rail-next h-12 w-12 rounded-full border border-sand/40 hover:bg-sand hover:text-ink" tabindex="-1">→</button>
        </div>
      </div>
    </div>
    <div id="exp-rail" class="rail relative mt-14 flex gap-6 overflow-x-auto pb-6" style="padding-inline: max(1.25rem, calc((100vw - 1320px) / 2 + 3rem)); scroll-padding-inline: max(1.25rem, calc((100vw - 1320px) / 2 + 3rem));" tabindex="0" aria-label="Experiences">
      {EXPERIENCES.map((e) => (
        <article class="w-[78vw] shrink-0 sm:w-[380px]">
          <Photo slot={e.slot} ratio="4/5" sizes="380px" class="arch-mask" label={e.title} />
          <p class="eyebrow mt-6 !text-saffron">{e.tag} · {e.where}</p>
          <h3 class="mt-3 text-3xl">{e.title}</h3>
          <p class="mt-3 text-sand/75">{e.text}</p>
        </article>
      ))}
    </div>
    <div class="container-x relative mt-10">
      <a href="/things-to-do/" class="btn-clay">See all things to do</a>
    </div>
  </section>

  <!-- Breather + proverb -->
  <section class="relative isolate flex min-h-[70vh] items-center overflow-hidden text-sand">
    <Photo slot="atlasValley" class="!absolute inset-0 -z-20 h-full w-full" label="High Atlas valley" />
    <div class="absolute inset-0 -z-10 bg-ink/55"></div>
    <figure class="container-x reveal py-24 text-center">
      <blockquote class="mx-auto max-w-4xl font-display text-4xl italic leading-tight md:text-6xl">
        “Whoever wants honey must be patient with the sting of the bees.”
      </blockquote>
      <figcaption class="eyebrow mt-8 !text-saffron">Moroccan proverb</figcaption>
    </figure>
  </section>

  <!-- Sample route -->
  <section class="container-x grid gap-14 py-24 md:grid-cols-12 md:py-36">
    <div class="md:col-span-5">
      <div class="md:sticky md:top-28">
        <SectionHead eyebrow="A first idea" title="Eight days, <em>Marrakech to Fes</em>" intro="Our most-requested first route: city, mountains, desert and medina, with no day longer than it needs to be." />
        <a href="/contact/" class="btn-clay reveal mt-8">Make it mine</a>
      </div>
    </div>
    <ol class="md:col-span-7">
      {route.map((r, i) => (
        <li class="reveal grid grid-cols-[auto_1fr] gap-6 border-t border-ink/15 py-7 last:border-b">
          <span class="font-display text-5xl italic text-clay/80 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <p class="eyebrow">{r.day}</p>
            <h3 class="mt-2 text-2xl md:text-3xl">{r.place}</h3>
            <p class="mt-2 text-ink/70">{r.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Food strip -->
  <section class="bg-plaster py-24 md:py-32">
    <div class="container-x grid items-center gap-14 md:grid-cols-12">
      <div class="reveal md:col-span-5">
        <Photo slot="tea" ratio="1/1" sizes="(min-width: 768px) 40vw, 100vw" class="rounded-full" label="Mint tea" />
      </div>
      <div class="md:col-span-7">
        <SectionHead eyebrow="At the table" title="Eat like you’re <em>expected</em>" intro="Moroccan hospitality is measured in food. Eight things to try before you leave:" />
        <ul class="reveal mt-10 grid gap-x-10 gap-y-6 sm:grid-cols-2">
          {FOODS.map((f) => (
            <li>
              <h3 class="text-xl font-semibold">{f.name}</h3>
              <p class="mt-1 text-sm text-ink/70">{f.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- How we plan -->
  <section class="container-x py-24 md:py-36">
    <SectionHead center eyebrow="How we plan your trip" title="Three steps, <em>no pressure</em>" />
    <ol class="mt-16 grid gap-12 md:grid-cols-3 md:gap-8">
      {steps.map((s, i) => (
        <li class="reveal text-center">
          <span class="text-sm font-bold tracking-[0.3em] text-clay">{s.n}</span>
          <h3 class="mt-3 text-4xl md:text-5xl">{s.title}</h3>
          <div class:list={['dot-rule mx-auto mt-6 w-full', i === 0 ? 'text-clay' : 'text-ink/25']}></div>
          <p class="mx-auto mt-6 max-w-xs text-ink/70">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- CTA -->
  <section class="relative isolate overflow-hidden bg-clay text-plaster">
    <div class="zellige-bg absolute inset-0 -z-10 opacity-10"></div>
    <div class="container-x flex flex-col items-start justify-between gap-10 py-20 md:flex-row md:items-center md:py-28">
      <h2 class="max-w-3xl text-balance text-4xl leading-tight md:text-6xl">Ready when you are. <em>Tell us</em> where your Morocco begins.</h2>
      <a href="/contact/" class="btn shrink-0 bg-plaster text-clay-deep hover:bg-ink hover:text-sand">Start planning</a>
    </div>
  </section>
</Base>

<script>
  const rail = document.getElementById('exp-rail');
  const step = () => (rail?.clientWidth ?? 600) * 0.8;
  document.querySelector('.rail-prev')?.addEventListener('click', () => rail?.scrollBy({ left: -step(), behavior: 'smooth' }));
  document.querySelector('.rail-next')?.addEventListener('click', () => rail?.scrollBy({ left: step(), behavior: 'smooth' }));
</script>
