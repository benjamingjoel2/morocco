---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Photo from '../components/Photo.astro';
import Logo from '../components/Logo.astro';
import { EXPERIENCES } from '../data/experiences';

const pillars = [
  {
    slot: 'fes',
    title: 'Get lost<br />well',
    text: 'In the lanes of Fes and Marrakech, the best moments are the unplanned ones. We show you how to enjoy the maze, and how to find your way out.',
    href: '/destinations/fes/',
  },
  {
    slot: 'atlas',
    title: 'Walk the<br />Atlas',
    text: 'Ninety minutes from the souks, mule paths climb between walnut terraces and earth-walled Amazigh villages.',
    href: '/destinations/atlas/',
  },
  {
    slot: 'sahara',
    title: 'Hear the<br />silence',
    text: 'A night beneath the Erg Chebbi dunes, a fire, a sky full of stars: the evening most travellers talk about for years.',
    href: '/destinations/sahara/',
  },
];

const steps = [
  { n: '01', word: 'Listen', text: 'Tell us your dates, your pace and what you dream of seeing. A short form, no payment, no obligation.' },
  { n: '02', word: 'Sketch', text: 'Within two working days we send a day-by-day route: riads and camps, drive times, guides, and honest notes on what to skip.' },
  { n: '03', word: 'Travel', text: 'We fine-tune it together, then you go. A local contact is one message away for the whole journey.' },
];

const route = [
  { day: 'Days 1–3', place: 'Marrakech', text: 'Riad, souks, gardens and a food walk through Jemaa el-Fnaa.' },
  { day: 'Day 4', place: 'Tizi n’Tichka to Aït Benhaddou', text: 'Cross the High Atlas and sleep near the ksar.' },
  { day: 'Day 5', place: 'Dadès & Todra gorges', text: 'Canyon walks along the Road of a Thousand Kasbahs.' },
  { day: 'Day 6', place: 'Merzouga', text: 'Sunset into the Erg Chebbi and a night in camp.' },
  { day: 'Days 7–8', place: 'Fes', text: 'North through the Ziz valley, then two days in the old medina.' },
];

const notes = [
  { slot: 'chefchaouen', tag: 'Guide', title: 'Eight places to go in Morocco, and how long to stay', by: 'Destinations', href: '/destinations/' },
  { slot: 'souk', tag: 'Guide', title: 'Desert camps, hammams, festivals and what to eat', by: 'Things to do', href: '/things-to-do/' },
  { slot: 'madrasa', tag: 'Practical', title: 'Visas, dirhams, trains and how to dress in the medina', by: 'Travel tips', href: '/travel-tips/' },
];
---
<Base
  title="Azul Morocco · Slow, tailor-made journeys through Morocco"
  description="Azul Morocco is an independent guide to Morocco: Marrakech, Fes, Chefchaouen, the Sahara at Merzouga, the Atlas Mountains and Essaouira, with tailor-made trip planning."
  overlayHeader
>
  <Hero />

  <!-- Experiences rail -->
  <section class="bg-char pb-24 pt-20 text-white md:pb-36 md:pt-[78px]">
    <div class="container-x">
      <h2 class="eyebrow text-center !text-gold-soft">Experiences in Morocco</h2>
      <div class="relative mt-14 h-px bg-white/25"><div id="rail-progress" class="absolute inset-y-0 left-0 w-1/4 bg-white transition-[width] duration-300"></div></div>
      <div class="mt-5 hidden justify-end gap-6 md:flex">
        <button class="rail-btn font-sans text-[0.72rem] uppercase tracking-[0.15em] text-white/80 hover:text-white disabled:opacity-30" data-dir="-1" aria-controls="exp-rail">← Previous</button>
        <button class="rail-btn font-sans text-[0.72rem] uppercase tracking-[0.15em] text-white/80 hover:text-white disabled:opacity-30" data-dir="1" aria-controls="exp-rail">Next →</button>
      </div>
    </div>
    <div id="exp-rail" class="rail mt-6 flex scroll-px-5 gap-6 overflow-x-auto px-5 sm:scroll-px-8 sm:px-8 lg:scroll-px-[42px] lg:px-[42px]" tabindex="0" aria-label="Experiences">
      {EXPERIENCES.map((e) => (
        <article class="w-[82vw] shrink-0 sm:w-[513px]">
          <Photo slot={e.slot} ratio="3/2" sizes="(min-width: 640px) 513px, 82vw" label={e.title} />
          <p class="mt-6 font-sans text-[0.72rem] uppercase tracking-[0.15em] text-white/70">{e.tag} · {e.where}</p>
          <h3 class="mt-2 font-serif text-[1.9rem] leading-tight">{e.title}</h3>
          <p class="body-copy mt-4 max-w-[440px] text-white/90">{e.text}</p>
          <a href={`/things-to-do/#exp-${e.slot}`} class="mt-6 inline-block font-sans text-[0.72rem] uppercase tracking-[0.15em] text-gold-soft hover:text-white">Discover more</a>
        </article>
      ))}
    </div>
  </section>

  <!-- Welcome split -->
  <section class="grid md:grid-cols-2">
    <Photo slot="aitbenhaddou" ratio="1/1" sizes="(min-width: 768px) 50vw, 100vw" label="Aït Benhaddou" />
    <div class="reveal flex flex-col items-center justify-center bg-greige px-8 py-20 text-center">
      <Logo class="h-14 w-11 text-gold" />
      <p class="eyebrow mt-8">An independent guide to Morocco</p>
      <p class="body-copy mt-4 max-w-[420px] text-ink/85">
        <em>Azul</em> is how you say hello in Tamazight. We plan slow, tailor-made journeys through Morocco for travellers who would rather stay a little longer and see a little deeper.
      </p>
      <a href="/contact/" class="btn-dash mt-10 text-mute">Plan a trip</a>
    </div>
  </section>

  <!-- Full-bleed statement -->
  <section class="relative isolate flex min-h-[90vh] items-center justify-center overflow-hidden text-white">
    <Photo slot="marrakech" class="!absolute inset-0 -z-20 h-full w-full" label="Marrakech" />
    <div class="absolute inset-0 -z-10 bg-night/40"></div>
    <h2 class="display reveal px-4 text-center !text-white text-[4.2rem] sm:text-[6.5rem] lg:text-[8.75rem]">Come in,<br />the tea is poured</h2>
  </section>

  <!-- Purpose -->
  <section class="container-x py-24 text-center md:py-32">
    <div class="reveal mx-auto max-w-[420px]">
      <h2 class="eyebrow">Why travel slowly</h2>
      <p class="body-copy mt-4 text-ink/85">Morocco rewards those who stay. Fewer places, longer stays, and time to say yes to the second glass of tea.</p>
    </div>
  </section>

  <!-- At a glance -->
  <section class="container-x pb-24 md:pb-32" aria-labelledby="glance-title">
    <h2 id="glance-title" class="eyebrow text-center">Morocco at a glance</h2>
    <dl class="reveal mt-10 grid grid-cols-2 border-t border-ink md:grid-cols-5">
      {[
        ['Currency', 'Dirham (MAD)', 'A closed currency: get it on arrival'],
        ['Languages', 'Arabic & Tamazight', 'French is widely spoken'],
        ['Time', 'GMT+1', 'Usually GMT during Ramadan'],
        ['Plugs', 'Type C & E', '220 V'],
        ['Visa', 'Often not needed', 'Up to 90 days for many passports'],
      ].map(([k, v, note]) => (
        <div class="border-b border-dashed border-ink/40 px-2 py-6 text-center md:border-b-0 md:border-r md:last:border-r-0">
          <dt class="font-sans text-[0.72rem] uppercase tracking-[0.15em] text-gold">{k}</dt>
          <dd class="mt-2 font-serif text-[1.35rem] leading-tight">{v}</dd>
          <dd class="mt-1 font-sans text-xs text-ink/80">{note}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-8 text-center"><a href="/travel-tips/" class="link-dash text-ink">All travel tips</a></p>
  </section>

  <!-- Checkerboard -->
  <section>
    {pillars.map((p, i) => (
      <div class:list={['grid', i % 2 === 0 ? 'md:grid-cols-[1.86fr_1fr]' : 'md:grid-cols-[1fr_1.86fr]']}>
        <div class:list={[i % 2 === 1 && 'md:order-2']}>
          <Photo slot={p.slot} ratio="1/1" sizes="(min-width: 768px) 65vw, 100vw" fluid class="aspect-[1/1] min-w-0 h-full md:aspect-auto md:min-h-[640px]" label={p.title.replace('<br />', ' ')} />
        </div>
        <div class="reveal flex flex-col items-center justify-center bg-greige px-8 py-20 text-center">
          <h3 class="display text-[3.4rem] md:text-[4.4rem]" set:html={p.title} />
          <p class="body-copy mt-6 max-w-[230px] text-[1rem] text-ink/85">{p.text}</p>
          <a href={p.href} class="mt-8 font-sans text-[0.72rem] uppercase tracking-[0.15em] text-gold hover:text-ink">Discover more</a>
        </div>
      </div>
    ))}
  </section>

  <!-- Process -->
  <section class="container-x py-24 md:py-32" id="process">
    <div class="reveal mx-auto max-w-[420px] text-center">
      <h2 class="eyebrow">How we plan</h2>
      <p class="body-copy mt-4 text-ink/85">Every trip is drawn by hand, around you. Here is how it works:</p>
      <a href="/contact/" class="btn-dash mt-10 text-mute">Start here</a>
    </div>
    <div class="mt-24" data-tabs>
      <div class="grid grid-cols-3" role="tablist" aria-label="How we plan">
        {steps.map((s, i) => (
          <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`step-${i}`} id={`tab-${i}`} class="group flex flex-col items-center pb-3 text-ink/70 aria-selected:text-ink" data-tab={i}>
            <span class="font-sans text-[0.72rem]">{s.n}</span>
            <span class="display !text-current mt-1 text-[2.4rem] sm:text-[3.4rem] md:text-[4.4rem]">{s.word}</span>
          </button>
        ))}
      </div>
      <div class="relative text-ink/50">
        <div class="rule-dots w-full"></div>
        <div id="tab-bar" class="absolute left-0 top-0 h-px w-1/3 bg-gold transition-transform duration-500"></div>
      </div>
      {steps.map((s, i) => (
        <p id={`step-${i}`} role="tabpanel" aria-labelledby={`tab-${i}`} class:list={['body-copy mx-auto mt-10 max-w-[520px] text-center text-ink/85', i !== 0 && 'hidden']}>{s.text}</p>
      ))}
    </div>
  </section>

  <!-- First route -->
  <section id="route" class="scroll-mt-20 bg-linen py-24 md:py-32">
    <div class="container-x grid gap-14 md:grid-cols-2">
      <div class="reveal">
        <h2 class="eyebrow">A first route</h2>
        <p class="display-left mt-6 text-[3.4rem] md:text-[4.4rem] !text-ink">Eight days,<br />Marrakech to Fes</p>
        <p class="body-copy mt-6 max-w-md text-ink/85">Our most-requested first journey: city, mountains, desert and medina, with no day longer than it needs to be.</p>
        <div class="mt-10 flex flex-wrap items-center gap-8"><a href="/contact/?route=eight-days" class="btn-dash text-mute">Make it mine</a><a href="/routes/" class="link-dash text-ink">See all routes</a></div>
      </div>
      <ol class="reveal">
        {route.map((r) => (
          <li class="grid grid-cols-[6.5rem_1fr] gap-4 border-b border-dashed border-ink/40 py-5 first:border-t first:border-solid first:border-t-ink">
            <span class="pt-1.5 font-sans text-[0.72rem] uppercase tracking-[0.15em] text-gold">{r.day}</span>
            <div>
              <h3 class="font-serif text-[1.5rem] leading-tight">{r.place}</h3>
              <p class="body-copy mt-1 text-[1rem] text-ink/75">{r.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Travel lightly -->
  <section class="bg-chalk pt-24 text-center md:pt-36">
    <div class="reveal container-x mx-auto max-w-[420px]">
      <h2 class="eyebrow">Travel lightly</h2>
      <p class="body-copy mt-4 text-ink/85">We work with local guides, family-run riads and women’s cooperatives, so more of what you spend stays in the valleys you visit.</p>
    </div>
    <div class="mx-auto mt-14 h-28 w-px border-l border-dashed border-ink/40"></div>
  </section>
  <section class="relative isolate flex min-h-[90vh] items-center justify-center overflow-hidden text-white">
    <Photo slot="atlasValley" class="!absolute inset-0 -z-20 h-full w-full" label="High Atlas valley" />
    <div class="absolute inset-0 -z-10 bg-night/35"></div>
    <h2 class="display reveal px-4 text-center !text-white text-[4.2rem] sm:text-[6.5rem] lg:text-[8.75rem]">Stay longer,<br />go deeper</h2>
  </section>

  <!-- Quote -->
  <section class="bg-linen py-24 md:py-32">
    <figure class="reveal container-x text-center">
      <figcaption class="eyebrow">A Moroccan saying</figcaption>
      <blockquote class="mx-auto mt-14 max-w-[560px] font-display text-[2.6rem] leading-[1.05] text-night md:text-[3.2rem]">
        “Whoever wants honey must be patient with the sting of the bees”
      </blockquote>
      <p class="body-copy mt-6 text-gold">Darija proverb</p>
    </figure>
  </section>

  <!-- Field notes -->
  <section class="container-x py-24 md:py-32">
    <h2 class="eyebrow text-center">Field notes</h2>
    <div class="mt-14 grid gap-10 sm:grid-cols-3 sm:gap-4">
      {notes.map((n) => (
        <a href={n.href} class="reveal group block">
          <Photo slot={n.slot} ratio="2/3" sizes="(min-width: 640px) 33vw, 100vw" imgClass="transition-transform duration-700 group-hover:scale-[1.03]" label={n.by} />
          <p class="mt-5 font-sans text-[0.72rem] uppercase tracking-[0.15em] text-ink/75">{n.tag}</p>
          <h3 class="mt-2 font-serif text-[1.6rem] leading-tight">{n.title}</h3>
          <p class="mt-4 font-sans text-sm text-ink">{n.by}</p>
          <span class="mt-5 inline-block font-sans text-[0.72rem] text-gold">Read more</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<script>
  // Experiences rail: arrow buttons and a progress hairline
  const rail = document.getElementById('exp-rail');
  const progress = document.getElementById('rail-progress');
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.rail-btn'));
  if (rail && progress) {
    const update = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      const ratio = rail.clientWidth / rail.scrollWidth;
      const pos = max > 0 ? rail.scrollLeft / max : 1;
      progress.style.width = `${Math.max(ratio, Math.min(1, ratio + pos * (1 - ratio))) * 100}%`;
      btns.forEach((b) => (b.disabled = b.dataset.dir === '-1' ? rail.scrollLeft <= 2 : rail.scrollLeft >= max - 2));
    };
    rail.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    btns.forEach((b) => b.addEventListener('click', () => rail.scrollBy({ left: Number(b.dataset.dir) * rail.clientWidth * 0.75, behavior: 'smooth' })));
    update();
  }

  const root = document.querySelector('[data-tabs]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role=tab]'));
    const bar = document.getElementById('tab-bar')!;
    const select = (i: number) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        document.getElementById(`step-${j}`)?.classList.toggle('hidden', i !== j);
      });
      bar.style.transform = `translateX(${i * 100}%)`;
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => select(i)));
    root.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      const cur = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
      if (k === 'ArrowRight' || k === 'ArrowLeft') {
        const next = (cur + (k === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;
        select(next); tabs[next].focus();
      }
    });
  }
</script>
