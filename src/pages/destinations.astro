---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { DESTINATIONS } from '../data/destinations';

const label = 'font-sans text-[0.72rem] uppercase tracking-[0.15em] text-gold';
---
<Base
  title="Destinations in Morocco: Marrakech, Fes, Chefchaouen, Sahara & more"
  description="Where to go in Morocco: Marrakech, Fes, Chefchaouen, the Sahara at Merzouga, the High Atlas, Essaouira, Aït Benhaddou and the Taghazout surf coast, with how long to stay and how to get there."
  overlayHeader
>
  <PageHero
    slot="chefchaouen"
    eyebrow="Destinations"
    title="Eight places,<br />eight moods"
    intro="Morocco packs snow peaks, Atlantic surf and Saharan dunes into a single week’s drive. Here is where to go, how long to stay and how to get there."
    label="Chefchaouen"
  />

  <nav aria-label="Jump to destination" class="sticky top-[72px] z-30 border-b border-ink/10 bg-white">
    <ul class="rail container-x flex gap-8 overflow-x-auto py-4">
      {DESTINATIONS.map((d) => (
        <li class="shrink-0"><a href={`#${d.id}`} class="font-sans text-[0.72rem] uppercase tracking-[0.15em] text-ink/70 hover:text-ink">{d.name}</a></li>
      ))}
    </ul>
  </nav>

  {DESTINATIONS.map((d, i) => (
    <article id={d.id} class="grid scroll-mt-32 md:grid-cols-2">
      <div class:list={[i % 2 === 1 && 'md:order-2']}>
        <Photo slot={d.slot} eager={i === 0} ratio="4/5" sizes="(min-width: 768px) 50vw, 100vw" fluid class="aspect-[4/5] min-w-0 h-full md:aspect-auto md:min-h-[760px]" label={d.name} />
      </div>
      <div class:list={['reveal flex flex-col justify-center px-6 py-20 sm:px-12 lg:px-20', i % 2 === 0 ? 'bg-greige' : 'bg-chalk']}>
        <p class="eyebrow">{d.region}</p>
        <h2 class="display-left mt-5 text-[3.6rem] md:text-[4.6rem]"><a href={`/destinations/${d.id}/`}>{d.name}</a></h2>
        <p class="mt-4 font-serif text-[1.35rem] italic text-ink">{d.tagline}</p>
        <p class="body-copy mt-5 text-ink/85">{d.intro}</p>

        <dl class="mt-8 grid gap-5 border-y border-dashed border-ink/40 py-6 sm:grid-cols-2">
          <div><dt class={label}>Stay</dt><dd class="mt-1 font-serif text-lg">{d.stay}</dd></div>
          <div><dt class={label}>Best time</dt><dd class="mt-1 font-serif text-lg">{d.season}</dd></div>
          <div class="sm:col-span-2"><dt class={label}>Getting there</dt><dd class="mt-1 font-serif text-lg font-light">{d.gettingThere}</dd></div>
        </dl>

        <p class:list={[label, 'mt-8']}>Don’t miss</p>
        <ul class="mt-2">
          {d.dontMiss.map((x) => <li class="border-b border-dashed border-ink/30 py-2.5 font-serif text-[1.05rem] font-light">{x}</li>)}
        </ul>
        <p class="mt-6 font-sans text-[0.72rem] uppercase tracking-[0.15em] text-ink/75">Best for · {d.bestFor.join(' · ')}</p>
        <div class="mt-8 flex flex-wrap items-center gap-8">
          <a href={`/destinations/${d.id}/`} class="btn-dash text-ink">Read the {d.name.split(',')[0].split(' & ')[0]} guide</a>
          <a href={`/contact/?place=${encodeURIComponent(d.name)}`} class="link-dash text-ink">Plan a trip here</a>
        </div>
      </div>
    </article>
  ))}

  <section class="bg-char py-24 text-center text-white md:py-32">
    <div class="reveal container-x">
      <p class="eyebrow !text-gold-soft">Can’t choose?</p>
      <p class="display mt-6 !text-white text-[3.4rem] md:text-[5.5rem]">One city, one landscape,<br />one place to rest</p>
      <p class="body-copy mx-auto mt-6 max-w-md text-white/85">That is the shape of most good first trips. Tell us what you love and we will sketch the rest.</p>
      <a href="/contact/" class="btn-dash mt-10 text-white">Ask for a route</a>
    </div>
  </section>
</Base>
