---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { DESTINATIONS } from '../data/destinations';
---
<Base
  title="Destinations in Morocco: Marrakech, Fes, Chefchaouen, Sahara & more"
  description="Where to go in Morocco: Marrakech, Fes, Chefchaouen, the Sahara at Merzouga, the High Atlas, Essaouira, Aït Benhaddou and the Taghazout surf coast, with how long to stay and how to get there."
  overlayHeader
>
  <PageHero
    slot="chefchaouen"
    eyebrow="Destinations"
    title="Eight places, <em>eight moods</em>"
    intro="Morocco packs snow peaks, Atlantic surf and Saharan dunes into a single week’s drive. Here is where to go, how long to stay and how to get there."
    label="Chefchaouen"
  />

  <nav aria-label="Jump to destination" class="sticky top-20 z-30 border-b border-ink/10 bg-sand/95 backdrop-blur">
    <ul class="rail container-x flex gap-2 overflow-x-auto py-3">
      {DESTINATIONS.map((d) => (
        <li class="shrink-0">
          <a href={`#${d.id}`} class="inline-block rounded-full border border-ink/15 px-4 py-2 text-sm font-semibold hover:border-clay hover:text-clay">{d.name}</a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="container-x py-16 md:py-24">
    {DESTINATIONS.map((d, i) => (
      <article id={d.id} class="grid scroll-mt-40 items-center gap-10 border-b border-ink/10 py-16 last:border-0 md:grid-cols-12 md:gap-14 md:py-24">
        <div class:list={['reveal md:col-span-6', i % 2 === 1 && 'md:order-2']}>
          <Photo
            slot={d.slot}
            ratio={i % 3 === 0 ? '4/5' : '5/4'}
            sizes="(min-width: 768px) 50vw, 100vw"
            class:list={[i % 3 === 0 ? 'arch-mask' : 'rounded-[1.5rem]']}
            label={d.name}
          />
        </div>
        <div class="reveal md:col-span-6">
          <p class="eyebrow">{d.region}</p>
          <h2 class="mt-3 text-5xl leading-none md:text-6xl">{d.name}</h2>
          <p class="mt-4 font-display text-2xl italic text-clay">{d.tagline}</p>
          <p class="mt-5 text-lg text-ink/80">{d.intro}</p>

          <dl class="mt-8 grid gap-5 rounded-2xl bg-plaster p-6 sm:grid-cols-2">
            <div>
              <dt class="eyebrow !text-mint">Stay</dt>
              <dd class="mt-1 font-semibold">{d.stay}</dd>
            </div>
            <div>
              <dt class="eyebrow !text-mint">Best time</dt>
              <dd class="mt-1 font-semibold">{d.season}</dd>
            </div>
            <div class="sm:col-span-2">
              <dt class="eyebrow !text-mint">Getting there</dt>
              <dd class="mt-1">{d.gettingThere}</dd>
            </div>
          </dl>

          <h3 class="mt-8 text-xl font-semibold">Don’t miss</h3>
          <ul class="mt-3 space-y-2">
            {d.dontMiss.map((x) => (
              <li class="flex gap-3"><span class="mt-[0.55rem] h-1.5 w-1.5 shrink-0 rotate-45 bg-saffron"></span><span class="text-ink/80">{x}</span></li>
            ))}
          </ul>
          <p class="mt-6 flex flex-wrap gap-2">
            {d.bestFor.map((b) => <span class="rounded-full bg-chaouen/45 px-3 py-1 text-xs font-semibold text-majorelle">{b}</span>)}
          </p>
        </div>
      </article>
    ))}
  </div>

  <section class="bg-plaster">
    <div class="container-x grid items-center gap-10 py-20 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="eyebrow">Can’t choose?</p>
        <h2 class="mt-4 text-4xl md:text-5xl">Most first trips combine <em>one city, one landscape</em> and one place to rest.</h2>
      </div>
      <div class="md:col-span-5 md:text-right">
        <a href="/contact/" class="btn-clay">Ask us for a route</a>
      </div>
    </div>
  </section>
</Base>
