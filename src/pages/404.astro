---
import Base from '../layouts/Base.astro';
---
<Base title="Lost in the medina" description="This page could not be found on Azul Morocco.">
  <section class="container-x flex min-h-[70vh] flex-col items-start justify-center pt-28">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 text-5xl md:text-7xl">Lost in the <em class="text-clay">medina</em>?</h1>
    <p class="mt-6 max-w-lg text-lg text-ink/75">It happens to everyone in Fes. This lane is a dead end, but the way back is easy.</p>
    <a href="/" class="btn-clay mt-8">Back to the main square</a>
  </section>
</Base>
