---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { UI, localize, type Lang } from '../i18n';
import { JOURNAL } from '../i18n/pages/journal';
import { articles, formatDate } from '../i18n/journal';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = JOURNAL[lang];
const L = (p: string) => localize(lang, p);
const list = await articles(lang);
const [first, ...rest] = list;
const small = 'font-sans text-[0.72rem] uppercase tracking-[0.15em]';
---
<Base title={t.metaTitle} description={t.metaDescription} overlayHeader>
  <PageHero photo="jemaa" eyebrow={t.eyebrow} title={t.title} intro={t.intro} label={t.heroLabel} />

  {first && (
    <section class="container-x py-20 md:py-28">
      <a href={L(`/journal/${first.slug}/`)} class="group grid items-center gap-10 md:grid-cols-[1.4fr_1fr] md:gap-16">
        <Photo photo={first.data.photo} ratio="3/2" sizes="(min-width: 768px) 58vw, 100vw" imgClass="transition-transform duration-700 group-hover:scale-[1.03]" label={first.data.title} />
        <div class="reveal">
          <p class:list={[small, 'text-gold']}>{first.data.tag} · {formatDate(first.data.date, lang)} · {t.minRead(first.minutes)}</p>
          <h2 class="mt-4 font-serif text-[2.2rem] leading-tight md:text-[2.8rem]">{first.data.title}</h2>
          <p class="body-copy mt-5 text-ink/80">{first.data.description}</p>
          <span class="link-dash mt-8 text-ink">{UI[lang].readMore}</span>
        </div>
      </a>
    </section>
  )}

  <section class="container-x pb-24 md:pb-32">
    <div class="grid gap-x-4 gap-y-14 border-t border-ink pt-14 sm:grid-cols-2 lg:grid-cols-4">
      {rest.map((a) => (
        <a href={L(`/journal/${a.slug}/`)} class="reveal group block">
          <Photo photo={a.data.photo} ratio="4/5" sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" imgClass="transition-transform duration-700 group-hover:scale-[1.03]" label={a.data.title} />
          <p class:list={[small, 'mt-5 text-ink/75']}>{a.data.tag} · {t.minRead(a.minutes)}</p>
          <h3 class="mt-2 font-serif text-[1.5rem] leading-tight">{a.data.title}</h3>
          <p class="body-copy mt-2 text-[1rem] text-ink/75">{a.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
