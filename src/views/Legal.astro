---
import Base from '../layouts/Base.astro';
import { type Lang } from '../i18n';
import { legalFor } from '../data/legal.mjs';
import { SITE } from '../data/site';

interface Props { lang: Lang; doc: 'privacy' | 'terms' | 'cookies'; }
const { lang, doc } = Astro.props;

const EYEBROW = { en: 'Legal', fr: 'Mentions légales', de: 'Rechtliches', es: 'Información legal' } satisfies Record<Lang, string>;
const docs = legalFor(lang);
const d = doc === 'terms' ? docs.terms : doc === 'cookies' ? docs.cookies : docs.privacy;
---
<Base title={d.title} description={`${d.title}: ${SITE.name}.`}>
  <section class="container-x pb-24 pt-36 md:pt-44">
    <p class="eyebrow">{EYEBROW[lang]}</p>
    <h1 class="display-left mt-5 text-[3rem] md:text-[4.5rem]">{d.title}</h1>
    <p class="body-copy mt-6 max-w-2xl text-ink/80">{d.intro}</p>
    <div class="prose-article legal mt-12 max-w-3xl">
      {d.sections.map((s) => (
        <>
          <h2>{s.h}</h2>
          <Fragment set:html={s.html} />
        </>
      ))}
    </div>
  </section>
</Base>
