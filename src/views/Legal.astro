---
import Base from '../layouts/Base.astro';
import { type Lang, localize } from '../i18n';
import { SITE, addressLine } from '../data/site';
import { LEGAL } from '../data/legal.mjs';

interface Props { lang: Lang; doc: 'privacy' | 'terms' | 'cookies'; }
const { lang, doc } = Astro.props;

/** Per-language strings passed into the shared legal copy (src/data/legal.mjs). */
const L10N = {
  en: {
    updated: '30 October 2026',
    eyebrow: 'Legal',
    processor: 'with our website host and email provider, who process data on our behalf under contract;',
    storage: { kind: 'Local storage', purpose: 'Remembers which items you ticked on the packing checklist (Travel Tips page).', duration: 'Until you clear site data' },
    enquiryNote: 'The enquiry form is sent to our form-handling provider, which delivers it to our inbox.',
    thirdParty: 'Fonts are served from this website’s own domain. Photos load from our image delivery provider, which does not set cookies.',
  },
  fr: {
    updated: '30 octobre 2026',
    eyebrow: 'Mentions légales',
    processor: 'avec notre hébergeur et notre messagerie, qui traitent les données pour notre compte dans le cadre d’un contrat ;',
    storage: { kind: 'Stockage local', purpose: 'Mémorise les cases cochées de la liste de bagages (page Conseils pratiques).', duration: 'Jusqu’à ce que vous effaciez les données du site' },
    enquiryNote: 'Le formulaire de demande est transmis à notre prestataire de formulaires, qui le remet dans notre boîte mail.',
    thirdParty: 'Les polices sont servies depuis le domaine de ce site. Les photos sont chargées depuis notre fournisseur de diffusion d’images, qui ne dépose pas de cookie.',
  },
  de: {
    updated: '30. Oktober 2026',
    eyebrow: 'Rechtliches',
    processor: 'an unseren Hosting- und E-Mail-Anbieter, die Daten in unserem Auftrag auf vertraglicher Grundlage verarbeiten;',
    storage: { kind: 'Lokaler Speicher', purpose: 'Merkt sich, was Sie auf der Packliste abgehakt haben (Seite Reisetipps).', duration: 'Bis Sie die Websitedaten löschen' },
    enquiryNote: 'Das Anfrageformular wird an unseren Formulardienst übermittelt, der es an unser Postfach weiterleitet.',
    thirdParty: 'Schriften werden von der eigenen Domain dieser Website geladen. Fotos kommen von unserem Bildauslieferungsdienst, der keine Cookies setzt.',
  },
  es: {
    updated: '30 de octubre de 2026',
    eyebrow: 'Información legal',
    processor: 'con nuestro proveedor de alojamiento web y de correo, que tratan los datos por cuenta nuestra en virtud de un contrato;',
    storage: { kind: 'Almacenamiento local', purpose: 'Recuerda qué elementos ha marcado en la lista de equipaje (página Consejos de viaje).', duration: 'Hasta que borre los datos del sitio' },
    enquiryNote: 'El formulario de solicitud se envía a nuestro proveedor de formularios, que lo entrega en nuestro buzón.',
    thirdParty: 'Las fuentes se sirven desde el propio dominio de este sitio. Las fotos se cargan desde nuestro proveedor de distribución de imágenes, que no instala cookies.',
  },
} satisfies Record<Lang, unknown>;

const l = L10N[lang];
const docs = LEGAL[lang]({
  brand: SITE.name,
  email: SITE.email,
  address: addressLine(lang),
  updated: l.updated,
  processors: [l.processor],
  storage: [{ name: 'azul-packing', ...l.storage }],
  enquiryNote: l.enquiryNote,
  thirdParty: l.thirdParty,
});
const d = doc === 'terms' ? docs.terms : doc === 'cookies' ? docs.cookies : docs.privacy;
const cookiesUrl = localize(lang, '/cookies/');
---
<Base title={d.title} description={d.intro}>
  <section class="container-x pb-24 pt-36 md:pt-44">
    <p class="eyebrow">{l.eyebrow}</p>
    <h1 class="display-left mt-5 text-[3rem] md:text-[4.5rem]">{d.title}</h1>
    <p class="body-copy mt-6 max-w-2xl text-ink/80">{d.intro}</p>
    <div class="prose-article legal mt-12 max-w-3xl">
      {d.sections.map((s) => (
        <>
          <h2>{s.h}</h2>
          <Fragment set:html={s.html.replace('COOKIES_URL', cookiesUrl)} />
        </>
      ))}
    </div>
  </section>
</Base>
