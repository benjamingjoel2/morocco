---
interface Props { eyebrow: string; title: string; intro?: string; center?: boolean; tone?: 'dark' | 'light'; }
const { eyebrow, title, intro, center = false, tone = 'dark' } = Astro.props;
---
<div class:list={['reveal max-w-3xl', center && 'mx-auto text-center']}>
  <p class:list={['eyebrow', tone === 'light' && '!text-saffron']}>{eyebrow}</p>
  <h2 class="mt-4 text-balance text-4xl leading-[1.04] md:text-6xl" set:html={title} />
  {intro && <p class:list={['mt-5 text-lg', tone === 'light' ? 'text-sand/80' : 'text-ink/75']}>{intro}</p>}
</div>
