---
import Logo from './Logo.astro';
import Photo from './Photo.astro';

interface Props { overlay?: boolean; }
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;

const MENU = [
  { href: '/', label: 'Home' },
  { href: '/destinations/', label: 'Destinations' },
  { href: '/things-to-do/', label: 'Things to Do' },
  { href: '/routes/', label: 'Routes' },
  { href: '/travel-tips/', label: 'Travel Tips' },
  { href: '/contact/', label: 'Plan a Trip' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const bar = 'font-sans text-[0.72rem] uppercase tracking-[0.15em]';
---
<header
  id="site-header"
  data-overlay={overlay ? 'true' : 'false'}
  class:list={['fixed inset-x-0 top-0 z-50 transition-[background-color,color,border-color] duration-500 border-b', overlay ? 'on-photo border-transparent text-white' : 'border-ink/10 bg-white text-ink']}
>
  <div class="container-x grid h-[72px] grid-cols-3 items-center">
    <div class="flex items-center gap-8 sm:gap-12">
      <button id="menu-open" class={bar} aria-expanded="false" aria-controls="site-menu">Menu</button>
      <a href="/contact/" class:list={[bar, 'hidden sm:inline']}>Plan a trip</a>
    </div>
    <a href="/" class="justify-self-center" aria-label="Azul Morocco, home"><Logo /></a>
    <a href="/travel-tips/" class:list={[bar, 'justify-self-end']}>Travel tips</a>
  </div>
</header>

<div id="site-menu" class="fixed inset-0 z-[60] hidden bg-white text-ink" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="container-x grid h-[72px] grid-cols-3 items-center border-b border-ink/10">
    <div class="flex items-center gap-8 sm:gap-12">
      <button id="menu-close" class={bar}>Close</button>
      <a href="/contact/" class:list={[bar, 'hidden sm:inline']}>Plan a trip</a>
    </div>
    <a href="/" class="justify-self-center" aria-label="Azul Morocco, home"><Logo /></a>
    <a href="/travel-tips/" class:list={[bar, 'justify-self-end']}>Travel tips</a>
  </div>
  <div class="grid h-[calc(100%-72px)] md:grid-cols-2">
    <nav aria-label="Main" class="flex flex-col justify-between px-5 py-10 sm:px-8 lg:px-[42px]">
      <ul class="max-w-[550px]">
        {MENU.map((m) => (
          <li class="border-b border-dashed border-ink/40 first:border-solid first:border-ink">
            <a
              href={m.href}
              class:list={['block py-2 font-sans text-[2rem] font-light leading-tight transition-colors hover:text-ink', isActive(m.href) ? 'text-ink' : 'text-ink/65']}
              aria-current={isActive(m.href) ? 'page' : undefined}
            >{m.label}</a>
          </li>
        ))}
      </ul>
      <p class="eyebrow !text-ink/70">ⴰⵣⵓⵍ · Azul means hello in Tamazight</p>
    </nav>
    <a href="/routes/#eight-days" class="group relative hidden overflow-hidden text-white md:block">
      <Photo photo="essaouira" class="!absolute inset-0 h-full w-full" imgClass="transition-transform duration-[1.5s] group-hover:scale-105" sizes="50vw" label="Essaouira" />
      <div class="absolute inset-0 bg-night/45"></div>
      <div class="on-photo relative flex h-full flex-col items-center justify-center px-8 text-center">
        <p class="display !text-white text-[5rem]">Marrakech<br />to Fes</p>
        <span class="link-dash mt-8">See a first route</span>
      </div>
    </a>
  </div>
</div>

<script>
  const header = document.getElementById('site-header')!;
  if (header.dataset.overlay === 'true') {
    const solid = ['bg-white', 'text-ink', 'border-ink/10'];
    const onScroll = () => {
      const scrolled = window.scrollY > window.innerHeight * 0.85;
      solid.forEach((c) => header.classList.toggle(c, scrolled));
      header.classList.toggle('text-white', !scrolled);
      header.classList.toggle('on-photo', !scrolled);
      header.classList.toggle('border-transparent', !scrolled);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const menu = document.getElementById('site-menu')!;
  const openBtn = document.getElementById('menu-open')!;
  const closeBtn = document.getElementById('menu-close')!;
  const toggle = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';
    openBtn.setAttribute('aria-expanded', String(open));
    (open ? closeBtn : openBtn).focus();
  };
  openBtn.addEventListener('click', () => toggle(true));
  closeBtn.addEventListener('click', () => toggle(false));
  document.addEventListener('keydown', (e) => {
    if (menu.classList.contains('hidden')) return;
    if (e.key === 'Escape') return toggle(false);
    if (e.key !== 'Tab') return;
    // Keep keyboard focus inside the open menu
    const items = Array.from(menu.querySelectorAll<HTMLElement>('a[href], button')).filter((el) => el.offsetParent !== null);
    const first = items[0], last = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });
</script>
