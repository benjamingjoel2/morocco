---
import Logo from './Logo.astro';
import Photo from './Photo.astro';
import { UI, LANGS, LANG_NAMES, langFromUrl, localize, unlocalize } from '../i18n';

interface Props { overlay?: boolean; }
const { overlay = false } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = UI[lang];
const L = (p: string) => localize(lang, p);
const path = unlocalize(Astro.url.pathname);
// Language selector: the same page in each language.
// The 404 page only exists once, so its selector points at each language's home page.
const target = /^\/404/.test(path) ? '/' : path;
const langLinks = LANGS.map((l) => ({ lang: l, href: localize(l, target), name: LANG_NAMES[l], current: l === lang }));

const MENU = [
  { href: '/', label: t.home },
  { href: '/destinations/', label: t.nav.destinations },
  { href: '/things-to-do/', label: t.nav.things },
  { href: '/routes/', label: t.nav.routes },
  { href: '/travel-tips/', label: t.nav.tips },
  { href: '/journal/', label: t.nav.journal },
  { href: '/contact/', label: t.nav.plan },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const bar = 'font-sans text-[0.72rem] uppercase tracking-[0.15em]';
---
<header
  id="site-header"
  data-overlay={overlay ? 'true' : 'false'}
  class:list={['fixed inset-x-0 top-0 z-50 transition-[background-color,color,border-color] duration-500 border-b', overlay ? 'on-photo border-transparent text-white' : 'border-ink/10 bg-white text-ink']}
>
  <div class="container-x grid h-[72px] grid-cols-3 items-center">
    <div class="flex items-center gap-8 sm:gap-12">
      <button id="menu-open" class={bar} aria-expanded="false" aria-controls="site-menu">{t.menu}</button>
      <a href={L('/contact/')} class:list={[bar, 'hidden sm:inline']}>{t.planTrip}</a>
    </div>
    <a href={L('/')} class="justify-self-center" aria-label={t.homeAria}><Logo /></a>
    <div class="flex items-center gap-6 justify-self-end sm:gap-10">
      <a href={L('/journal/')} class:list={[bar, 'hidden sm:inline']}>{t.journal}</a>
      <nav aria-label={t.language} class="lang-select">
        <ul class:list={[bar, 'flex items-center']}>
          {langLinks.map((l, i) => (
            <li class="flex items-center">
              {i > 0 && <span aria-hidden="true" class="px-1 opacity-60 sm:px-1.5">·</span>}
              <a href={l.href} hreflang={l.lang} lang={l.lang} aria-label={l.name} aria-current={l.current ? 'true' : undefined} class:list={['rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4', l.current ? 'underline underline-offset-4' : 'opacity-75 hover:opacity-100']}>{l.lang.toUpperCase()}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>

<div id="site-menu" class="fixed inset-0 z-[60] hidden bg-white text-ink" role="dialog" aria-modal="true" aria-label={t.menu}>
  <div class="container-x grid h-[72px] grid-cols-3 items-center border-b border-ink/10">
    <div class="flex items-center gap-8 sm:gap-12">
      <button id="menu-close" class={bar}>{t.close}</button>
      <a href={L('/contact/')} class:list={[bar, 'hidden sm:inline']}>{t.planTrip}</a>
    </div>
    <a href={L('/')} class="justify-self-center" aria-label={t.homeAria}><Logo /></a>
    <div class="flex items-center gap-6 justify-self-end sm:gap-10">
      <a href={L('/journal/')} class:list={[bar, 'hidden sm:inline']}>{t.journal}</a>
      <nav aria-label={t.language} class="lang-select">
        <ul class:list={[bar, 'flex items-center']}>
          {langLinks.map((l, i) => (
            <li class="flex items-center">
              {i > 0 && <span aria-hidden="true" class="px-1 opacity-60 sm:px-1.5">·</span>}
              <a href={l.href} hreflang={l.lang} lang={l.lang} aria-label={l.name} aria-current={l.current ? 'true' : undefined} class:list={['rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4', l.current ? 'underline underline-offset-4' : 'opacity-75 hover:opacity-100']}>{l.lang.toUpperCase()}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
  <div class="grid h-[calc(100%-72px)] md:grid-cols-2">
    <nav aria-label={t.menu} class="flex flex-col justify-between px-5 py-10 sm:px-8 lg:px-[42px]">
      <ul class="max-w-[550px]">
        {MENU.map((m) => (
          <li class="border-b border-dashed border-ink/40 first:border-solid first:border-ink">
            <a
              href={L(m.href)}
              class:list={['block py-2 font-sans text-[2rem] font-light leading-tight transition-colors hover:text-ink', isActive(m.href) ? 'text-ink' : 'text-ink/65']}
              aria-current={isActive(m.href) ? 'page' : undefined}
            >{m.label}</a>
          </li>
        ))}
      </ul>
      <p class="eyebrow !text-ink/70">{t.azulMeans}</p>
    </nav>
    <a href={L('/routes/#eight-days')} class="group relative hidden overflow-hidden text-white md:block">
      <Photo photo="essaouira" class="!absolute inset-0 h-full w-full" imgClass="transition-transform duration-[1.5s] group-hover:scale-105" sizes="50vw" label="Essaouira" />
      <div class="absolute inset-0 bg-night/45"></div>
      <div class="on-photo relative flex h-full flex-col items-center justify-center px-8 text-center">
        <p class="display !text-white text-[5rem]" set:html={t.menuFeature} />
        <span class="link-dash mt-8">{t.menuFeatureLink}</span>
      </div>
    </a>
  </div>
</div>

<script>
  const header = document.getElementById('site-header')!;
  if (header.dataset.overlay === 'true') {
    const solid = ['bg-white', 'text-ink', 'border-ink/10'];
    const onScroll = () => {
      const scrolled = window.scrollY > window.innerHeight * 0.85;
      solid.forEach((c) => header.classList.toggle(c, scrolled));
      header.classList.toggle('text-white', !scrolled);
      header.classList.toggle('on-photo', !scrolled);
      header.classList.toggle('border-transparent', !scrolled);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const menu = document.getElementById('site-menu')!;
  const openBtn = document.getElementById('menu-open')!;
  const closeBtn = document.getElementById('menu-close')!;
  const toggle = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';
    openBtn.setAttribute('aria-expanded', String(open));
    (open ? closeBtn : openBtn).focus();
  };
  openBtn.addEventListener('click', () => toggle(true));
  closeBtn.addEventListener('click', () => toggle(false));
  document.addEventListener('keydown', (e) => {
    if (menu.classList.contains('hidden')) return;
    if (e.key === 'Escape') return toggle(false);
    if (e.key !== 'Tab') return;
    // Keep keyboard focus inside the open menu
    const items = Array.from(menu.querySelectorAll<HTMLElement>('a[href], button')).filter((el) => el.offsetParent !== null);
    const first = items[0], last = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });
</script>
