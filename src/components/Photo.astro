---
import { getPhoto, unsplashUrl } from '../data/media';

interface Props {
  slot: string;
  /** Aspect ratio such as "4/5"; omit to fill the parent (use with h-full). */
  ratio?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
  imgClass?: string;
  label?: string;
  /** Crop to `ratio` but let CSS classes size the box (for split layouts). */
  fluid?: boolean;
  /** Don't download until a script copies data-src/data-srcset across (hidden slides). */
  defer?: boolean;
}

const { slot, ratio, sizes = '100vw', eager = false, class: cls = '', imgClass = '', label, fluid = false, defer = false } = Astro.props;
const photo = getPhoto(slot);
const widths = [480, 768, 1080, 1440, 1920, 2400];
const [rw, rh] = (ratio ?? '1/1').split('/').map(Number);
const style = ratio && !fluid ? `aspect-ratio:${ratio}` : undefined;
---
{photo ? (
  <div class:list={['relative overflow-hidden', cls]} style={`${style ?? ''};background:${photo.color}`}>
    <img
      src={defer ? undefined : unsplashUrl(photo.src, 1440, ratio)}
      srcset={defer ? undefined : widths.map((w) => `${unsplashUrl(photo.src, w, ratio)} ${w}w`).join(', ')}
      data-src={defer ? unsplashUrl(photo.src, 1440, ratio) : undefined}
      data-srcset={defer ? widths.map((w) => `${unsplashUrl(photo.src, w, ratio)} ${w}w`).join(', ') : undefined}
      sizes={sizes}
      alt={photo.alt}
      width={ratio ? 1440 : photo.width}
      height={ratio ? Math.round((1440 * rh) / rw) : photo.height}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
      class:list={['absolute inset-0 h-full w-full object-cover', imgClass]}
    />
  </div>
) : (
  <div
    class:list={['relative flex items-center justify-center overflow-hidden bg-greige text-gold', cls]}
    style={style}
    role="img"
    aria-label={label ?? slot}
  >
    <svg viewBox="0 0 48 60" class="h-16 w-12 opacity-40" aria-hidden="true">
      <path d="M10 58V30A16 16 0 1 1 38 30V58" fill="none" stroke="currentColor" stroke-width="1.6" />
      <g fill="currentColor"><rect x="18" y="22" width="12" height="12" /><rect x="18" y="22" width="12" height="12" transform="rotate(45 24 28)" /></g>
    </svg>
    {label && <span class="eyebrow absolute bottom-5 left-5">{label}</span>}
  </div>
)}
