---
import { getPhoto, unsplashUrl } from '../data/media';

interface Props {
  slot: string;
  /** Aspect ratio such as "4/5"; omit to fill the parent (use with h-full). */
  ratio?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
  imgClass?: string;
  label?: string;
}

const { slot, ratio, sizes = '100vw', eager = false, class: cls = '', imgClass = '', label } = Astro.props;
const photo = getPhoto(slot);
const widths = [480, 768, 1080, 1440, 1920, 2400];
const [rw, rh] = (ratio ?? '1/1').split('/').map(Number);
const style = ratio ? `aspect-ratio:${ratio}` : undefined;
---
{photo ? (
  <div class:list={['relative overflow-hidden', cls]} style={`${style ?? ''};background:${photo.color}`}>
    <img
      src={unsplashUrl(photo.src, 1440, ratio)}
      srcset={widths.map((w) => `${unsplashUrl(photo.src, w, ratio)} ${w}w`).join(', ')}
      sizes={sizes}
      alt={photo.alt}
      width={ratio ? 1440 : photo.width}
      height={ratio ? Math.round((1440 * rh) / rw) : photo.height}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
      class:list={['absolute inset-0 h-full w-full object-cover', imgClass]}
    />
  </div>
) : (
  <div
    class:list={['relative flex items-end overflow-hidden bg-clay-deep text-sand', cls]}
    style={style}
    role="img"
    aria-label={label ?? slot}
  >
    <div class="zellige-bg absolute inset-0 opacity-20"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-clay-deep/40 to-clay/30"></div>
    {label && <span class="relative m-5 font-display text-xl italic opacity-90">{label}</span>}
  </div>
)}
