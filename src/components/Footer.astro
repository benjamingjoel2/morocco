---
import Logo from './Logo.astro';
import { UI, langFromUrl, localize } from '../i18n';
import { SITE, addressLine } from '../data/site';

const year = new Date().getFullYear();
const lang = langFromUrl(Astro.url);
const t = UI[lang];
const links = [
  { href: '/destinations/', label: t.nav.destinations },
  { href: '/things-to-do/', label: t.nav.things },
  { href: '/routes/', label: t.nav.routes },
  { href: '/travel-tips/', label: t.nav.tips },
  { href: '/journal/', label: t.nav.journal },
  { href: '/contact/', label: t.nav.plan },
].map((l) => ({ ...l, href: localize(lang, l.href) }));
const legal = [
  { href: '/privacy/', label: t.legal.privacy },
  { href: '/booking-terms/', label: t.legal.terms },
  { href: '/cookies/', label: t.legal.cookies },
].map((l) => ({ ...l, href: localize(lang, l.href) }));
const small = 'font-sans text-[0.72rem] uppercase tracking-[0.15em]';
---
<footer class="bg-greige text-ink">
  <div class="container-x pb-10 pt-20">
    <div class="flex flex-col items-center text-center">
      <Logo variant="wordmark" class="text-ink" />
      <p class="body-copy mt-6 max-w-md text-ink/80">{t.footerIntro}</p>
      <ul class="mt-10 flex flex-wrap justify-center gap-x-10 gap-y-4">
        {links.map((l) => <li><a href={l.href} class="link-dash">{l.label}</a></li>)}
      </ul>
    </div>

    <div class="mt-20">
      <p class="font-sans text-[0.78rem] text-ink/85">
        <a class="underline" href={`mailto:${SITE.email}`}>{SITE.email}</a> · {addressLine(lang)}
      </p>
      <p class="mt-2 font-sans text-[0.78rem] text-ink/85">{t.travelNote}</p>
      <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 border-t border-ink/30 pt-4 font-sans text-[0.78rem] text-ink/85">
        {legal.map((l) => <li><a class="hover:underline" href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>

    <div class="mt-14 flex flex-col justify-between gap-3 border-b border-ink pb-4 sm:flex-row">
      <p class:list={[small, 'text-ink/80']}>©{year} Azul Morocco. {t.rights}</p>
      <p class:list={[small, 'text-ink/80']} lang="zgh">ⴰⵣⵓⵍ</p>
    </div>
  </div>
</footer>
