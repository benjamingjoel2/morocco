---
import Logo from './Logo.astro';
import { UI, langFromUrl, localize } from '../i18n';
import { SITE, addressLine } from '../data/site';

const year = new Date().getFullYear();
const lang = langFromUrl(Astro.url);
const t = UI[lang];
const links = [
  { href: '/destinations/', label: t.nav.destinations },
  { href: '/things-to-do/', label: t.nav.things },
  { href: '/routes/', label: t.nav.routes },
  { href: '/travel-tips/', label: t.nav.tips },
  { href: '/journal/', label: t.nav.journal },
  { href: '/contact/', label: t.nav.plan },
].map((l) => ({ ...l, href: localize(lang, l.href) }));
const legal = [
  { href: '/privacy/', label: t.legal.privacy },
  { href: '/booking-terms/', label: t.legal.terms },
  { href: '/cookies/', label: t.legal.cookies },
].map((l) => ({ ...l, href: localize(lang, l.href) }));
const small = 'font-sans text-[0.72rem] uppercase tracking-[0.15em]';
---
<footer class="bg-greige text-ink">
  <div class="container-x pb-8 pt-16">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <Logo variant="wordmark" class="text-ink" />
        <p class="body-copy mt-5 max-w-sm text-ink/80">{t.footerIntro}</p>
        <p class="mt-5 font-sans text-[0.82rem] leading-relaxed text-ink/85">
          <a class="underline" href={`mailto:${SITE.email}`}>{SITE.email}</a><br />{addressLine(lang)}
        </p>
      </div>
      <nav class="md:col-span-7" aria-label={({ en: 'Footer', fr: 'Pied de page', de: 'Fußzeile', es: 'Pie de página' } as Record<string, string>)[lang] ?? 'Footer'}>
        <ul class="grid grid-cols-2 gap-x-8 gap-y-4 sm:grid-cols-3 md:pt-2">
          {links.map((l) => <li><a href={l.href} class:list={[small, 'hover:underline']}>{l.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <p class="mt-12 font-sans text-[0.78rem] text-ink/80">{t.travelNote}</p>
    <div class="mt-4 flex flex-col gap-3 border-t border-ink/30 pt-4 font-sans text-[0.78rem] text-ink/85 sm:flex-row sm:items-center sm:justify-between">
      <p>©{year} Azul Morocco. {t.rights} <span lang="zgh" class="ml-2">ⴰⵣⵓⵍ</span></p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {legal.map((l) => <li><a class="hover:underline" href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
