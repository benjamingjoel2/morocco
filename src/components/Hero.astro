---
import Photo from './Photo.astro';
import Logo from './Logo.astro';
import { heroVideo } from '../data/media';

const SLIDES = [
  { slot: 'hero', caption: 'Erg Chebbi, Merzouga', coords: '31.1° N  4.0° W' },
  { slot: 'chefchaouen', caption: 'Chefchaouen, Rif Mountains', coords: '35.2° N  5.3° W' },
  { slot: 'atlas', caption: 'High Atlas, Tacheddirt', coords: '31.2° N  7.8° W' },
  { slot: 'essaouira', caption: 'Essaouira, Atlantic coast', coords: '31.5° N  9.8° W' },
];
---
<section id="hero" class="relative isolate h-[100svh] min-h-[560px] overflow-hidden bg-night text-white">
  <h1 class="sr-only">Azul Morocco: slow, tailor-made journeys through Morocco</h1>
  {SLIDES.map((s, i) => (
    <div class:list={['hero-slide absolute inset-0 -z-20 transition-opacity duration-[1600ms]', i === 0 ? 'opacity-100' : 'opacity-0']} data-caption={s.caption} data-coords={s.coords}>
      <Photo photo={s.slot} eager={i === 0} defer={i > 0} class="!absolute inset-0 h-full w-full" imgClass="kenburns" />
    </div>
  ))}
  {heroVideo && (
    <video id="hero-video" class="absolute inset-0 -z-10 hidden h-full w-full object-cover" muted loop playsinline preload="none" poster={heroVideo.poster} data-src={heroVideo.src} aria-hidden="true"></video>
  )}
  <!-- Scrims behind the header and the bottom bar, strong enough for bright slides (snow, white walls) -->
  <div class="absolute inset-x-0 top-0 -z-10 h-48 bg-gradient-to-b from-night/70 to-transparent"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-72 bg-gradient-to-t from-night/80 via-night/40 to-transparent"></div>

  <div class="on-photo container-x absolute inset-x-0 bottom-0 grid grid-cols-2 items-end gap-6 pb-8 md:grid-cols-3 md:pb-10">
    <p id="hero-coords" class="hidden font-sans text-[0.72rem] uppercase tracking-[0.15em] md:block">{SLIDES[0].coords}</p>
    <div class="col-span-2 flex flex-col items-center justify-self-center text-center md:col-span-1">
      <p class="mb-4 font-serif text-[1.05rem] font-light italic leading-snug sm:text-[1.15rem]">Slow, tailor-made journeys through Morocco</p>
      <Logo variant="wordmark" />
    </div>
    <div class="col-span-2 w-full max-w-[200px] justify-self-center md:col-span-1 md:justify-self-end">
      <p id="hero-caption" class="font-sans text-[0.72rem] uppercase leading-snug tracking-[0.15em]">{SLIDES[0].caption}</p>
      <div class="relative mt-2 h-px w-full overflow-hidden bg-white/40"><div id="hero-progress" class="absolute inset-0 origin-left scale-x-0 bg-white will-change-transform"></div></div>
    </div>
  </div>
</section>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.hero-slide'));
  const caption = document.getElementById('hero-caption')!;
  const coords = document.getElementById('hero-coords')!;
  const bar = document.getElementById('hero-progress')!;
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DURATION = 6500;
  let i = 0;

  const run = () => {
    bar.style.transition = 'none';
    bar.style.transform = 'scaleX(0)';
    requestAnimationFrame(() => requestAnimationFrame(() => {
      bar.style.transition = `transform ${DURATION}ms linear`;
      bar.style.transform = 'scaleX(1)';
    }));
  };
  if (!calm && slides.length > 1) {
    // Each later slide downloads only when it is next in line, so nothing competes with the first paint.
    const prepare = (n: number) => slides[n]?.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((im) => {
      im.srcset = im.dataset.srcset ?? '';
      im.src = im.dataset.src ?? '';
      im.loading = 'eager';
      delete im.dataset.src;
    });
    const afterLoad = () => setTimeout(() => prepare(1), 1500);
    if (document.readyState === 'complete') afterLoad();
    else window.addEventListener('load', afterLoad);
    run();
    setInterval(() => {
      if (document.hidden) return;
      slides[i].classList.replace('opacity-100', 'opacity-0');
      i = (i + 1) % slides.length;
      slides[i].classList.replace('opacity-0', 'opacity-100');
      prepare((i + 1) % slides.length);
      caption.textContent = slides[i].dataset.caption ?? '';
      coords.textContent = slides[i].dataset.coords ?? '';
      run();
    }, DURATION);
  } else {
    bar.style.transform = 'scaleX(1)';
  }

  // Optional Pexels video: desktop only, never with reduced motion.
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;
  if (video?.dataset.src && !calm && window.matchMedia('(min-width: 768px)').matches) {
    video.src = video.dataset.src;
    video.classList.remove('hidden');
    video.play().catch(() => video.classList.add('hidden'));
  }
</script>
