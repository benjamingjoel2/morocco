---
/** The Azul mark (horseshoe arch around an 8-point zellige star) and wordmark. */
interface Props { variant?: 'mark' | 'wordmark'; class?: string; }
const { variant = 'mark', class: cls = '' } = Astro.props;
---
{variant === 'mark' ? (
  <svg viewBox="0 0 48 60" class:list={['h-11 w-9', cls]} aria-hidden="true">
    <path d="M10 58V30A16 16 0 1 1 38 30V58" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round" />
    <g fill="currentColor">
      <rect x="18" y="22" width="12" height="12" />
      <rect x="18" y="22" width="12" height="12" transform="rotate(45 24 28)" />
    </g>
  </svg>
) : (
  <span class:list={['inline-flex flex-col items-center leading-none', cls]}>
    <span class="font-display text-[2.1rem] uppercase tracking-[0.32em] pl-[0.32em]">Azul</span>
    <span class="mt-1 font-sans text-[0.55rem] uppercase tracking-[0.5em] pl-[0.5em] opacity-80">Morocco</span>
  </span>
)}
