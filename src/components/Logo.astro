---
interface Props { class?: string; tone?: 'light' | 'dark'; }
const { class: cls = '', tone = 'dark' } = Astro.props;
const fg = tone === 'light' ? 'text-sand' : 'text-ink';
---
<span class:list={['inline-flex items-center gap-3', fg, cls]}>
  <svg viewBox="0 0 48 60" class="h-10 w-8 shrink-0 text-clay" aria-hidden="true">
    <path d="M10 58V30A16 16 0 1 1 38 30V58" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linejoin="round" />
    <g fill="currentColor">
      <rect x="18" y="22" width="12" height="12" />
      <rect x="18" y="22" width="12" height="12" transform="rotate(45 24 28)" />
    </g>
    <circle cx="24" cy="28" r="2.4" fill="var(--color-sand)" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-display text-[1.7rem] italic font-medium tracking-tight">azul</span>
    <span class="mt-1 font-sans text-[0.58rem] font-bold uppercase tracking-[0.42em] opacity-80">Morocco</span>
  </span>
</span>
