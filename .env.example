# Copy to .env for local builds. Never commit real keys.
UNSPLASH_ACCESS_KEY=
# Optional: enables the hero video (Pexels key issuance is paused as of Oct 2026)
PEXELS_API_KEY=
# Optional: where the trip-request form POSTs JSON (e.g. a Formspree endpoint)
PUBLIC_FORM_ENDPOINT=
# Optional: canonical site URL used for sitemap / Open Graph
SITE_URL=
